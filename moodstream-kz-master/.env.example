# Database
DATABASE_URL="postgresql://moodstream:moodstream_dev@localhost:5432/moodstream"

# Redis
REDIS_URL="redis://localhost:6379"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="moodstream"
S3_SECRET_KEY="moodstream_dev"
S3_BUCKET_AUDIO="moodstream-audio"
S3_BUCKET_COVERS="moodstream-covers"
S3_REGION="us-east-1"

# Auth
JWT_ACCESS_SECRET="change_me_in_production_access"
JWT_REFRESH_SECRET="change_me_in_production_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# OTP (SMS provider — настроить под Kazakhstan)
OTP_PROVIDER="mock"        # mock | twilio | smsaero
OTP_EXPIRES_IN_SEC=300
OTP_MAX_ATTEMPTS=3

# Admin
ADMIN_SECRET_KEY="change_me_admin"
